# ==============================================================================
# FINDOM ENVIRONMENT CONFIGURATION (SUPABASE + NEXT.JS)
# ==============================================================================

# Supabase Project URL and Public Anon Key (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key for Edge Functions / Backend Webhooks (Never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
